# --- Core ---
PORT=4000
DATABASE_URL=postgresql://postgres:23044943@localhost:5432/WhatElse_db
REDIS_URL=redis://localhost:6379
WEB_ORIGIN=http://localhost:3000
APP_TIMEZONE=Africa/Tunis

# --- Security (generate: openssl rand -hex 32) ---
JWT_SECRET=replace-with-at-least-32-random-characters
# Exactly 64 hex characters. Encrypts social-account tokens at rest.
TOKEN_ENCRYPTION_KEY=
# Set true when served over HTTPS (production)
COOKIE_SECURE=false

# --- First admin, created on first boot if no users exist ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now-please

# --- Media ---
UPLOAD_DIR=./uploads
# Meta downloads media from this URL, so in production it must be public HTTPS
PUBLIC_BASE_URL=http://localhost:4000

# --- Meta (Facebook + Instagram). Leave blank until access is granted ---
META_GRAPH_VERSION=v26.0
META_APP_ID=
META_APP_SECRET=

# --- AI captions (optional: template fallback is used without a key) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
