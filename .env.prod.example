# Copy to .env.prod and fill in. Never commit .env.prod.
DOMAIN=campaign.example.com
POSTGRES_USER=campaign
POSTGRES_DB=WhatElse_db
POSTGRES_PASSWORD=change-me-long-random

# openssl rand -hex 32
JWT_SECRET=
# openssl rand -hex 32  (exactly 64 hex chars; losing it means reconnecting the accounts)
TOKEN_ENCRYPTION_KEY=

# First admin (created on first boot). Password 12+ characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=

APP_TIMEZONE=Africa/Tunis

# Meta: use the FACEBOOK app's id and secret (not the Instagram app pair).
# v26.0 is the version you tested in Graph Explorer.
META_GRAPH_VERSION=v26.0
META_APP_ID=
META_APP_SECRET=

# Optional: AI captions. Leave empty to use placeholder templates.
ANTHROPIC_API_KEY=


# --- Meta safety guard (all optional; the defaults below are the safe values) ---
# Minimum gap between two WRITES (publish/comment/reply) with the same token. Do not go below 30000.
META_MIN_WRITE_GAP_MS=30000
# Minimum gap between two READS, app-wide.
META_MIN_READ_GAP_MS=1500
# Pause ALL Meta calls when Meta reports this % of the quota used (x-app-usage / x-business-use-case-usage).
META_USAGE_PAUSE_PCT=70
# Daily budgets (UTC day). Writes are per account token, reads are app-wide.
META_DAILY_WRITE_CAP=40
META_DAILY_READ_CAP=1500
# Emergency stop: false = the app sends NOTHING to Meta.
META_API_ENABLED=true
# Comment polling, first comments, AI replies, moderation. Keep false until publishing has been stable for days.
META_COMMENT_AUTOMATION=false
# Background metrics sync (every 2 h). false = analytics only update when you import or click sync.
META_BACKGROUND_SYNC=true
# Refuse to publish the same caption + media twice inside this window (hours). 0 = off (tests only).
META_DUPLICATE_WINDOW_HOURS=24
